common --enable_bzlmod
build --define=backend=cpu
build --announce_rc
build --show_timestamps

build:cpu --define=backend=cpu
build:cuda --define=backend=cuda
build:rocm --define=backend=rocm
build:metal --define=backend=metal

build:release --compilation_mode=opt
build:release --strip=always

# BuildBuddy Workflows injects the API key and BES configuration. This named
# profile enables its shared cache without putting credentials in the repo.
build:buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
build:buildbuddy --remote_upload_local_results=true
build:buildbuddy --remote_download_minimal
build:buildbuddy --remote_timeout=3600
