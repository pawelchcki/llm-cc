DIST_VERSION = "0.1"

exports_files(["VERSION"])

genrule(
    name = "version_header",
    srcs = ["VERSION"],
    outs = ["generated/version.h"],
    # Follow --stamp: development builds use the VERSION fallback, while
    # release/install builds receive the workspace status files.
    stamp = -1,
    cmd = """
status_file=bazel-out/stable-status.txt
version=""
if [[ -f "$$status_file" ]]; then
  version=$$(grep '^STABLE_LLM_CC_VERSION ' "$$status_file" | cut -d' ' -f2- || true)
fi
if [[ -z "$$version" ]]; then
  base=$$(tr -d '[:space:]' < $(location VERSION))
  case "$$base" in
    [0-9]*.[0-9]*.[0-9]*) base=$${base%.*} ;;
  esac
  version="$$base.0+unknown"
fi
case "$$version" in
  *[!0-9A-Za-z.+-]*|'') echo "invalid VERSION: $$version" >&2; exit 1 ;;
esac
cat > "$@" <<EOF
#ifndef LLM_CC_GENERATED_VERSION_H_
#define LLM_CC_GENERATED_VERSION_H_
#define LLM_CC_VERSION "$$version"
#endif
EOF
""",
)

cc_library(
    name = "version",
    hdrs = [":version_header"],
)

