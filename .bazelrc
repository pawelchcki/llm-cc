common --enable_bzlmod
common --enable_platform_specific_config
build --announce_rc
build --show_timestamps
build --action_env=SOURCE_DATE_EPOCH=0
build --workspace_status_command=tools/bazel_status.sh

build:cpu --//:backend=cpu
build:cuda --//:backend=cuda
build:rocm --//:backend=rocm
build:metal --//:backend=metal

# Pin the non-redistributable Apple SDK boundary. Metal kernels are embedded as
# source, avoiding build-time metallib output that varies between Xcode builds.
build:metal --xcode_version=16.4
build:metal --macos_minimum_os=14.0

# Applied automatically on macOS by --enable_platform_specific_config so the
# default auto backend has the same compiler/SDK boundary as --config=metal.
build:macos --xcode_version=16.4
build:macos --macos_minimum_os=14.0

build:release --compilation_mode=opt
build:release --strip=always
build:release --stamp

# `bazel run` is used for release executables such as //:install.
run --compilation_mode=opt
run --strip=always
run --stamp

# Build Linux x86_64 binaries against the compact pinned GCC/glibc sysroot.
# This alias is retained for callers that already use --config=portable.
build:portable --extra_toolchains=@llvm_toolchain_portable//:cc-toolchain-x86_64-linux

# Linux is reproducible by default: never discover headers or libraries from
# the host distribution. Explicit --config=portable remains a useful alias.
build:linux --extra_toolchains=@llvm_toolchain_portable//:cc-toolchain-x86_64-linux

# BuildBuddy Workflows injects the API key and BES configuration. This named
# profile enables its shared cache without putting credentials in the repo.
build:buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
build:buildbuddy --remote_upload_local_results=true
build:buildbuddy --remote_download_minimal
build:buildbuddy --remote_timeout=3600
