common --enable_bzlmod
common --enable_platform_specific_config
build --announce_rc
build --show_timestamps
build --action_env=SOURCE_DATE_EPOCH=0
build --workspace_status_command=tools/bazel_status.sh
build --@rules_cuda//cuda:runtime=@cuda//:cuda_runtime_static

build:cpu --//:backend=cpu
build:cuda --//:backend=cuda
build:rocm --//:backend=rocm
build:metal --//:backend=metal
build:universal --//:backend=universal

# Metal kernels are embedded as source, avoiding build-time metallib output
# that varies between Xcode builds. Bazel discovers the active Xcode toolchain.
build:metal --macos_minimum_os=14.0

# Applied automatically on macOS by --enable_platform_specific_config so the
# auto backend has the same deployment target as --config=metal.
build:macos --macos_minimum_os=14.0

# MSVC defaults to C++14, while llm-cc uses C++20 library and language
# features, including std::span and designated initializers.
build:windows --cxxopt=/std:c++20

build:release --compilation_mode=opt
build:release --strip=always
build:release --stamp

# Distribution artifacts may resolve a matching published GPU bundle at run
# time. Source builds deliberately retain the default false setting.
build:distribution --config=release
build:distribution --//:auto_fetch_backends=true

# `bazel run` is used for release executables such as //:install.
run --compilation_mode=opt
run --strip=always
run --stamp

# Build Linux x86_64 binaries with pinned Clang and the portable glibc sysroot.
# This alias is retained for callers that already use --config=portable.
build:portable --extra_toolchains=@llvm_toolchain_portable//:cc-toolchain-x86_64-linux

# Linux is reproducible by default: never discover headers or libraries from
# the host distribution. Explicit --config=portable remains a useful alias.
build:linux --extra_toolchains=@llvm_toolchain_portable//:cc-toolchain-x86_64-linux

# BuildBuddy Workflows injects the API key and BES configuration. This named
# profile enables its shared cache without putting credentials in the repo.
build:buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
build:buildbuddy --noannounce_rc
build:buildbuddy --bes_backend=grpcs://remote.buildbuddy.io
build:buildbuddy --bes_results_url=https://app.buildbuddy.io/invocation/
build:buildbuddy --build_metadata=ROLE=CI
build:buildbuddy --remote_upload_local_results=true
build:buildbuddy --remote_download_minimal
build:buildbuddy --remote_timeout=3600

build:buildbuddy-rbe --config=buildbuddy
build:buildbuddy-rbe --remote_executor=grpcs://remote.buildbuddy.io
build:buildbuddy-rbe --remote_local_fallback=false

# Windows RBE requires a self-hosted Windows executor with MSVC installed.
# Add --remote_default_exec_properties=Pool=NAME when using a named pool.
build:buildbuddy-rbe-windows --config=buildbuddy-rbe
build:buildbuddy-rbe-windows --remote_default_exec_properties=OSFamily=windows
build:buildbuddy-rbe-windows --remote_default_exec_properties=Arch=amd64
build:buildbuddy-rbe-windows --remote_default_exec_properties=use-self-hosted-executors=true
