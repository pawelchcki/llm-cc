load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(["*.py"]) + glob(["consumer/*"]) + glob(["recipe/**"]) + ["//tools:__init__.py"],
)

[
    sh_binary(
        name = stage,
        srcs = ["launcher.sh"],
        args = ["$(rlocationpath :__main__.py)", stage],
        data = [":sources", ":__main__.py"],
    )
    for stage in [
        "prepare",
        "worker",
        "compare",
        "discover",
        "store-report",
        "publish",
        "ci",
    ]
]

sh_test(
    name = "comparison_test",
    srcs = ["launcher.sh"],
    args = ["$(rlocationpath :__main__.py)", "test"],
    data = [
        ":sources",
        ":__main__.py",
        "//:llm-cc-compare-fake",
    ],
    # The launcher resolves this runfile into LLM_CC for report aggregation.
    env = {"LLM_CC_RLOCATION": "$(rlocationpath //:llm-cc-compare-fake)"},
    env_inherit = ["PATH"],
    # The suite is dominated by subprocess and git fixtures; shards run in
    # parallel and each takes every fourth test.
    shard_count = 4,
)
