load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sdk",
    srcs = glob(["**"]),
)

filegroup(
    name = "clang",
    srcs = ["lib/llvm/bin/clang++"],
)

filegroup(
    name = "hipcc",
    srcs = ["bin/hipcc"],
)

# Narrow providers keep unrelated SDK components out of HIP action keys while
# retaining the complete pinned SDK repository for runtime closure resolution.
filegroup(
    name = "compiler_files",
    srcs = [
        "bin/hipcc",
        "lib/llvm/bin/clang",
        "lib/llvm/bin/clang++",
        "lib/llvm/bin/clang-23",
        "lib/llvm/bin/clang-linker-wrapper",
        "lib/llvm/bin/clang-offload-bundler",
        "lib/llvm/bin/clang-offload-packager",
        "lib/llvm/bin/ld.lld",
        "lib/llvm/bin/lld",
        "lib/llvm/bin/llvm-link",
        "lib/llvm/bin/llvm-mc",
        "lib/llvm/bin/opt",
    ] + glob([
        "lib/llvm/amdgcn/**",
        "lib/llvm/lib/clang/23/**",
    ]),
)

filegroup(
    name = "hip_headers",
    srcs = glob([
        "include/hip/**",
        "include/hipblas/**",
        "include/hipblas-common/**",
        "include/hipcub/**",
        "include/hsa/**",
        "include/rocblas/**",
        "include/rocm-core/**",
    ]),
)

filegroup(
    name = "link_files",
    srcs = [
        "lib/libamdhip64.so.7.14.60850-0000000",
        "lib/libhipblas.so.3.5",
        "lib/librocblas.so.5.5",
    ],
)

cc_import(
    name = "amdhip",
    shared_library = "lib/libamdhip64.so.7",
)

cc_import(
    name = "hipblas",
    shared_library = "lib/libhipblas.so.3",
)

cc_import(
    name = "rocblas",
    shared_library = "lib/librocblas.so.5",
)

cc_import(
    name = "amd_comgr",
    shared_library = "lib/libamd_comgr.so.3",
)

cc_import(
    name = "hipblaslt",
    shared_library = "lib/libhipblaslt.so.1",
)

cc_import(
    name = "hsa_runtime",
    shared_library = "lib/libhsa-runtime64.so.1",
)

cc_import(
    name = "rocprofiler_register",
    shared_library = "lib/librocprofiler-register.so.0",
)

cc_import(
    name = "rocm_kpack",
    shared_library = "lib/librocm_kpack.so.0",
)

cc_import(
    name = "rocsolver",
    shared_library = "lib/librocsolver.so.0",
)

cc_import(
    name = "roctx",
    shared_library = "lib/libroctx64.so.4",
)

cc_import(
    name = "clang_cpp",
    shared_library = "lib/llvm/lib/libclang-cpp.so.23.0git",
)

cc_import(
    name = "llvm",
    shared_library = "lib/llvm/lib/libLLVM.so.23.0git",
)

cc_import(
    name = "rocroller",
    shared_library = "lib/librocroller.so.1",
)

cc_import(
    name = "sysdeps_bz2",
    shared_library = "lib/rocm_sysdeps/lib/librocm_sysdeps_bz2.so",
)

cc_import(
    name = "sysdeps_drm",
    shared_library = "lib/rocm_sysdeps/lib/librocm_sysdeps_drm.so.2",
)

cc_import(
    name = "sysdeps_drm_amdgpu",
    shared_library = "lib/rocm_sysdeps/lib/librocm_sysdeps_drm_amdgpu.so.1",
)

cc_import(
    name = "sysdeps_elf",
    shared_library = "lib/rocm_sysdeps/lib/librocm_sysdeps_elf.so.1",
)

cc_import(
    name = "sysdeps_liblzma",
    shared_library = "lib/rocm_sysdeps/lib/librocm_sysdeps_liblzma.so.5",
)

cc_import(
    name = "sysdeps_numa",
    shared_library = "lib/rocm_sysdeps/lib/librocm_sysdeps_numa.so.1",
)

cc_import(
    name = "sysdeps_z",
    shared_library = "lib/rocm_sysdeps/lib/librocm_sysdeps_z.so.1",
)

cc_import(
    name = "sysdeps_zstd",
    shared_library = "lib/rocm_sysdeps/lib/librocm_sysdeps_zstd.so.1",
)

filegroup(
    name = "runtime_files",
    # Use source-file labels so Bazel preserves the SDK-relative paths in
    # runfiles. cc_import targets materialize under _solib instead.
    srcs = [
        ".kpack/blas_lib_gfx1100.kpack",
        ".kpack/blas_lib_gfx1101.kpack",
        ".kpack/blas_lib_gfx1102.kpack",
        "lib/libamd_comgr.so.3",
        "lib/libamdhip64.so.7",
        "lib/libhipblas.so.3",
        "lib/libhipblaslt.so.1",
        "lib/libhsa-runtime64.so.1",
        "lib/librocblas.so.5",
        "lib/librocm_kpack.so.0",
        "lib/librocprofiler-register.so.0",
        "lib/librocroller.so.1",
        "lib/librocsolver.so.0",
        "lib/libroctx64.so.4",
        "lib/llvm/lib/libLLVM.so.23.0git",
        "lib/llvm/lib/libclang-cpp.so.23.0git",
        "lib/rocm_sysdeps/lib/librocm_sysdeps_bz2.so",
        "lib/rocm_sysdeps/lib/librocm_sysdeps_drm.so.2",
        "lib/rocm_sysdeps/lib/librocm_sysdeps_drm_amdgpu.so.1",
        "lib/rocm_sysdeps/lib/librocm_sysdeps_elf.so.1",
        "lib/rocm_sysdeps/lib/librocm_sysdeps_liblzma.so.5",
        "lib/rocm_sysdeps/lib/librocm_sysdeps_numa.so.1",
        "lib/rocm_sysdeps/lib/librocm_sysdeps_z.so.1",
        "lib/rocm_sysdeps/lib/librocm_sysdeps_zstd.so.1",
    ] + glob([
        "lib/hipblaslt/**",
        "lib/rocblas/**",
    ], exclude = [
        "lib/hipblaslt/**/gfx1103/**",
        "lib/hipblaslt/**/*gfx1103*",
        "lib/rocblas/**/gfx1103/**",
        "lib/rocblas/**/*gfx1103*",
    ]),
)

cc_library(
    name = "runtime",
    # Vendor libraries are runtime data, not direct link dependencies of
    # llm-cc. libggml-hip records the subset it actually needs in DT_NEEDED.
    data = [":runtime_files"],
)
