common --enable_bzlmod
common --enable_platform_specific_config
build --action_env=SOURCE_DATE_EPOCH=0
build --@rules_cuda//cuda:runtime=@cuda//:cuda_runtime_static
build:linux --extra_toolchains=@llvm_toolchain_portable//:cc-toolchain-x86_64-linux
build:macos --macos_minimum_os=14.0
build:cpu --@llm_cc//:backend=cpu
build:cuda --@llm_cc//:backend=cuda
build:a10 --config=cuda
build:a10 --@llm_cc//:cuda_archs=compute_86:sm_86
build:release --compilation_mode=opt
build:release --strip=always
build:windows --cxxopt=/std:c++20
build:windows --enable_runfiles
build:windows --features=static_link_msvcrt
