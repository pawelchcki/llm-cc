package(default_visibility = ["//visibility:public"])

DIST_VERSION = "0.1"

exports_files(["VERSION"])

genrule(
    name = "version_header",
    srcs = ["VERSION"],
    outs = ["generated/version.h"],
    # Follow --stamp: development builds use the VERSION fallback, while
    # release/install builds receive the workspace status files.
    stamp = -1,
    cmd = """
status_file=bazel-out/stable-status.txt
version=""
if [[ -f "$$status_file" ]]; then
  version=$$(grep '^STABLE_LLM_CC_VERSION ' "$$status_file" | cut -d' ' -f2- || true)
fi
if [[ -z "$$version" ]]; then
  base=$$(tr -d '[:space:]' < $(location VERSION))
  case "$$base" in
    [0-9]*.[0-9]*.[0-9]*) base=$${base%.*} ;;
  esac
  version="$$base.0+unknown"
fi
case "$$version" in
  *[!0-9A-Za-z.+-]*|'') echo "invalid VERSION: $$version" >&2; exit 1 ;;
esac
cat > "$@" <<EOF
#ifndef LLM_CC_GENERATED_VERSION_H_
#define LLM_CC_GENERATED_VERSION_H_
#define LLM_CC_VERSION "$$version"
#endif
EOF
""",
)

cc_library(
    name = "version",
    hdrs = [":version_header"],
)

string_flag(
    name = "backend",
    build_setting_default = "auto",
    values = [
        "auto",
        "cpu",
        "cuda",
        "metal",
        "rocm",
    ],
)

config_setting(
    name = "backend_cuda",
    flag_values = {":backend": "cuda"},
)

config_setting(
    name = "backend_cpu",
    flag_values = {":backend": "cpu"},
)

config_setting(
    name = "backend_metal_explicit",
    flag_values = {":backend": "metal"},
)

config_setting(
    name = "backend_rocm_explicit",
    flag_values = {":backend": "rocm"},
)

config_setting(
    name = "backend_auto",
    flag_values = {":backend": "auto"},
)

config_setting(
    name = "target_linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "host_macos",
    constraint_values = ["@platforms//os:macos"],
)

selects.config_setting_group(
    name = "backend_universal",
    match_all = [
        ":backend_auto",
        ":target_linux_x86_64",
    ],
)

selects.config_setting_group(
    name = "backend_metal_auto",
    match_all = [
        ":backend_auto",
        ":host_macos",
    ],
)

selects.config_setting_group(
    name = "backend_rocm",
    match_any = [":backend_rocm_explicit"],
)

selects.config_setting_group(
    name = "backend_dynamic",
    match_any = [
        ":backend_cuda",
        ":backend_rocm",
        ":backend_universal",
    ],
)

selects.config_setting_group(
    name = "backend_metal",
    match_any = [
        ":backend_metal_auto",
        ":backend_metal_explicit",
    ],
)

cmake(
    name = "llama_cpp",
    cache_entries = select({
        ":backend_universal": llama_universal_cmake_options(),
        ":backend_cuda": llama_cuda_cmake_options(),
        ":backend_rocm": llama_rocm_cmake_options(),
        ":backend_metal": llama_cmake_options(
            BUILD_SHARED_LIBS = "OFF",
            GGML_METAL = "ON",
            GGML_METAL_EMBED_LIBRARY = "ON",
            GGML_METAL_MACOSX_VERSION_MIN = "14.0",
            GGML_METAL_NDEBUG = "ON",
            GGML_METAL_STD = "metal3.1",
        ),
        "//conditions:default": llama_cmake_options(),
    }),
    build_data = select({
        ":backend_universal": [
            "@cuda_sdk//:nvcc",
            "@cuda_sdk//:sdk",
            "@cuda_host_toolchain//:host_toolchain",
            "@rocm_sdk//:clang",
            "@rocm_sdk//:sdk",
            "//tools:cuda_host_compiler_wrapper.sh",
        ],
        ":backend_cuda": [
            "@cuda_sdk//:nvcc",
            "@cuda_sdk//:sdk",
            "@cuda_host_toolchain//:gxx",
            "@cuda_host_toolchain//:host_toolchain",
            "//tools:cuda_host_compiler_wrapper.sh",
        ],
        ":backend_rocm": [
            "@cuda_host_toolchain//:gcc_runtime",
            "@rocm_sdk//:clang",
            "@rocm_sdk//:sdk",
        ],
        "//conditions:default": [],
    }),
    generate_args = ["-GNinja"],
    lib_source = "@llama_cpp//:all",
    set_file_prefix_map = True,
    out_static_libs = select({
        ":backend_universal": [],
        ":backend_cuda": [],
        ":backend_rocm": [],
        ":backend_metal": [
            "libllama.a",
            "libggml.a",
            "libggml-base.a",
            "libggml-blas.a",
            "libggml-cpu.a",
            "libggml-metal.a",
        ],
        "//conditions:default": [
            "libllama.a",
            "libggml.a",
            "libggml-base.a",
            "libggml-cpu.a",
        ],
    }),
    out_shared_libs = select({
        ":backend_universal": [
            "libllama.so",
            "libggml.so",
            "libggml-base.so",
        ],
        ":backend_cuda": [
            "libllama.so",
            "libggml.so",
            "libggml-base.so",
        ],
        ":backend_rocm": [
            "libllama.so",
            "libggml.so",
            "libggml-base.so",
        ],
        ":backend_metal": [],
        "//conditions:default": [],
    }),
    out_data_files = select({
        ":backend_universal": [
            "lib/libllm-cc-backend-cpu.so",
            "lib/libllm-cc-backend-cuda.so",
            "lib/libllm-cc-backend-rocm.so",
        ],
        ":backend_cuda": [
            "lib/libllm-cc-backend-cpu.so",
            "lib/libllm-cc-backend-cuda.so",
        ],
        ":backend_rocm": [
            "lib/libllm-cc-backend-cpu.so",
            "lib/libllm-cc-backend-rocm.so",
        ],
        "//conditions:default": [],
    }),
)

configure_make_variant(
    name = "openssl",
    args = [
        # GNU Make exports command-line variables to recipes. OpenSSL's
        # build-info generator otherwise records the wall-clock time.
        "SOURCE_DATE_EPOCH=0",
        # These features are disabled, but OpenSSL still compiles their
        # default directories into libcrypto unless they are overridden.
        "ENGINESDIR=lib64/engines-3",
        "MODULESDIR=lib64/ossl-modules",
    ],
    configure_command = "Configure",
    configure_in_place = True,
    configure_options = [
        "--openssldir=/etc/ssl",
        "no-apps",
        "no-dso",
        "no-engine",
        "no-module",
        "no-shared",
        "no-tests",
        "no-zlib",
    ],
    lib_source = "@openssl//:all",
    out_lib_dir = "lib64",
    out_static_libs = [
        "libcrypto.a",
        "libssl.a",
    ],
    set_file_prefix_map = True,
    target_compatible_with = select({
        ":host_macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    targets = [
        "",
        # Install libraries and headers without populating --openssldir.
        "install_sw",
    ],
    toolchain = "@rules_foreign_cc//toolchains:built_make_toolchain",
)

cmake(
    name = "curl",
    cache_entries = select({
        ":host_macos": curl_cmake_options(
            CURL_USE_OPENSSL = "OFF",
            CURL_USE_SECTRANSP = "ON",
        ),
        "//conditions:default": curl_cmake_options(
            CURL_USE_OPENSSL = "ON",
            CURL_USE_SECTRANSP = "OFF",
        ),
    }),
    deps = select({
        ":host_macos": [],
        "//conditions:default": [":openssl"],
    }),
    generate_args = ["-GNinja"],
    lib_source = "@curl//:all",
    out_static_libs = ["libcurl.a"],
    set_file_prefix_map = True,
)

cc_library(
    name = "backend_runtime",
    srcs = ["src/backend.cc"],
    hdrs = ["src/backend.h"],
    defines = select({
        ":backend_dynamic": ["LLM_CC_DYNAMIC_BACKENDS"],
        ":backend_metal": ["LLM_CC_BUILTIN_GPU"],
        "//conditions:default": [],
    }),
    deps = [":llama_cpp"],
)

cc_library(
    name = "core",
    srcs = ["src/core.cc"],
    hdrs = ["src/core.h"],
)

cc_library(
    name = "cache",
    srcs = ["src/cache.cc"],
    hdrs = ["src/cache.h"],
    deps = ["@nlohmann_json//:json"],
)

cc_library(
    name = "download",
    srcs = ["src/download.cc"],
    hdrs = ["src/download.h"],
    linkopts = select({
        ":host_macos": [
            "-framework CoreFoundation",
            "-framework CoreServices",
            "-framework Security",
            "-framework SystemConfiguration",
        ],
        "//conditions:default": [],
    }),
    deps = [
        ":cache",
        ":curl",
    ],
)

cc_library(
    name = "jsonl",
    srcs = ["src/jsonl.cc"],
    hdrs = ["src/jsonl.h"],
    deps = [
        ":core",
        ":lang",
        "@nlohmann_json//:json",
    ],
)

cc_library(
    name = "lang",
    srcs = ["src/lang.cc"],
    hdrs = ["src/lang.h"],
    deps = [
        ":core",
        "@tree_sitter//:tree_sitter",
        "@tree_sitter_c//:grammar",
        "@tree_sitter_cpp//:grammar",
        "@tree_sitter_rust//:grammar",
    ],
)

cc_library(
    name = "score_cmd",
    srcs = ["src/score_cmd.cc"],
    hdrs = ["src/score_cmd.h"],
    deps = [
        ":backend_runtime",
        ":llama_cpp",
        ":scoring",
        ":version",
    ],
)

cc_library(
    name = "scoring",
    srcs = ["src/scoring.cc"],
    hdrs = ["src/scoring.h"],
)

cc_library(
    name = "test_util",
    hdrs = ["src/test_util.h"],
)

cc_binary(
    name = "llm-cc",
    srcs = ["src/cli/main.cc"],
    data = select({
        ":backend_universal": [
            ":llama_cpp",
            "@cuda_sdk//:runtime",
            "@cuda_host_toolchain//x86_64-buildroot-linux-gnu/sysroot:runtime",
            "@rocm_sdk//:runtime",
        ],
        ":backend_cuda": [
            ":llama_cpp",
            "@cuda_sdk//:runtime",
        ],
        ":backend_rocm": [
            ":llama_cpp",
            "@cuda_host_toolchain//x86_64-buildroot-linux-gnu/sysroot:runtime",
            "@rocm_sdk//:runtime",
        ],
        "//conditions:default": [],
    }),
    linkopts = select({
        ":backend_universal": [
            "-ldl",
            "-lpthread",
            "-Wl,--disable-new-dtags",
            "-Wl,-rpath,$$ORIGIN/lib",
            "-Wl,-rpath,$$ORIGIN/lib/cuda",
            "-Wl,-rpath,$$ORIGIN/lib/rocm",
            "-Wl,-rpath,$$ORIGIN/lib/rocm/llvm/lib",
            "-Wl,-rpath,$$ORIGIN/lib/rocm/rocm_sysdeps/lib",
            "-Wl,-rpath,$$ORIGIN/llm-cc.runfiles/+cuda_sdk_repository+cuda_sdk/sdk/lib",
            "-Wl,-rpath,$$ORIGIN/llm-cc.runfiles/+http_archive+rocm_sdk/lib",
            "-Wl,-rpath,$$ORIGIN/llm-cc.runfiles/+http_archive+rocm_sdk/lib/llvm/lib",
            "-Wl,-rpath,$$ORIGIN/llm-cc.runfiles/+http_archive+rocm_sdk/lib/rocm_sysdeps/lib",
            "-Wl,-rpath,$$ORIGIN/llm-cc.runfiles/+http_archive+cuda_host_toolchain/x86_64-buildroot-linux-gnu/sysroot/lib",
        ],
        ":backend_cuda": [
            "-ldl",
            "-lpthread",
            # DT_RPATH is intentionally transitive: vendor libraries have
            # further dependencies in the same checksum-pinned SDK.
            "-Wl,--disable-new-dtags",
            "-Wl,-rpath,$$ORIGIN/lib",
            "-Wl,-rpath,$$ORIGIN/lib/cuda",
            "-Wl,-rpath,$$ORIGIN/llm-cc.runfiles/+cuda_sdk_repository+cuda_sdk/sdk/lib",
            "-Wl,-rpath,$$ORIGIN/../+cuda_sdk_repository+cuda_sdk/sdk/lib",
        ],
        ":backend_rocm": [
            "-ldl",
            "-lpthread",
            "-Wl,--disable-new-dtags",
            "-Wl,-rpath,$$ORIGIN/lib",
            "-Wl,-rpath,$$ORIGIN/lib/rocm",
            "-Wl,-rpath,$$ORIGIN/lib/rocm/llvm/lib",
            "-Wl,-rpath,$$ORIGIN/lib/rocm/rocm_sysdeps/lib",
            "-Wl,-rpath,$$ORIGIN/llm-cc.runfiles/+http_archive+rocm_sdk/lib",
            "-Wl,-rpath,$$ORIGIN/llm-cc.runfiles/+http_archive+rocm_sdk/lib/llvm/lib",
            "-Wl,-rpath,$$ORIGIN/llm-cc.runfiles/+http_archive+rocm_sdk/lib/rocm_sysdeps/lib",
            "-Wl,-rpath,$$ORIGIN/../+http_archive+rocm_sdk/lib",
            "-Wl,-rpath,$$ORIGIN/../+http_archive+rocm_sdk/lib/llvm/lib",
            "-Wl,-rpath,$$ORIGIN/../+http_archive+rocm_sdk/lib/rocm_sysdeps/lib",
        ],
        ":backend_metal": [
            "-framework Accelerate",
            "-framework Foundation",
            "-framework Metal",
            "-framework MetalKit",
            "-lobjc",
        ],
        ":backend_cpu": [
            "-static",
            "-ldl",
            "-lpthread",
        ],
        "//conditions:default": ["-ldl", "-lpthread"],
    }),
    deps = [
        ":cache",
        ":core",
        ":download",
        ":jsonl",
        ":lang",
        ":score_cmd",
        ":version",
    ],
)

install_launcher(
    name = "install",
    binary = ":llm-cc",
    payload = ":install_payload",
    script = "//tools:install.sh",
    version_script = "//tools:version.sh",
)

payload_archive(
    name = "install_payload",
    binary = ":llm-cc",
    cuda_runtime = "@cuda_sdk//:runtime_files",
    host_runtime = "@cuda_host_toolchain//x86_64-buildroot-linux-gnu/sysroot:runtime_files",
    kind = "auto",
    llama = ":llama_cpp",
    output_name = "llm-cc-install-payload.tar.gz",
    rocm_runtime = "@rocm_sdk//:runtime_files",
    root_name = "llm-cc-payload",
)

payload_archive(
    name = "universal_archive",
    binary = ":llm-cc",
    cuda_runtime = "@cuda_sdk//:runtime_files",
    host_runtime = "@cuda_host_toolchain//x86_64-buildroot-linux-gnu/sysroot:runtime_files",
    kind = "universal",
    llama = ":llama_cpp",
    output_name = "llm-cc-%s-linux-x86_64-universal.tar.gz" % DIST_VERSION,
    rocm_runtime = "@rocm_sdk//:runtime_files",
    root_name = "llm-cc-%s-linux-x86_64-universal" % DIST_VERSION,
    target_compatible_with = select({
        ":backend_universal": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

payload_archive(
    name = "cpu_static_archive",
    binary = ":llm-cc",
    cuda_runtime = "@cuda_sdk//:runtime_files",
    host_runtime = "@cuda_host_toolchain//x86_64-buildroot-linux-gnu/sysroot:runtime_files",
    kind = "static",
    llama = ":llama_cpp",
    output_name = "llm-cc-%s-linux-x86_64-cpu-static.tar.gz" % DIST_VERSION,
    rocm_runtime = "@rocm_sdk//:runtime_files",
    root_name = "llm-cc-%s-linux-x86_64-cpu-static" % DIST_VERSION,
    target_compatible_with = select({
        ":backend_cpu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

