            CURL_USE_OPENSSL = "ON",
            CURL_USE_SECTRANSP = "OFF",
            OPENSSL_CRYPTO_LIBRARY = "$$EXT_BUILD_DEPS/openssl_/lib64/libcrypto.a",
            OPENSSL_INCLUDE_DIR = "$$EXT_BUILD_DEPS/openssl_/include",
            OPENSSL_ROOT_DIR = "$$EXT_BUILD_DEPS/openssl_",
            OPENSSL_SSL_LIBRARY = "$$EXT_BUILD_DEPS/openssl_/lib64/libssl.a",
            OPENSSL_USE_STATIC_LIBS = "ON",
        ),
    }),
    deps = select({
