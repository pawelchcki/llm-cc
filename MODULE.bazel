module(
    name = "llm_cc",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_cuda", version = "0.3.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "toolchains_llvm", version = "1.8.0")

single_version_override(
    module_name = "rules_foreign_cc",
    patch_strip = 1,
    patches = ["//third_party:rules_foreign_cc_reproducible_logs.patch"],
    version = "0.15.1",
)

single_version_override(
    module_name = "rules_cuda",
    patch_strip = 1,
    patches = ["//third_party:rules_cuda_explicit_tools.patch"],
    version = "0.3.0",
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    cxx_standard = {"": "c++20"},
    llvm_version = "22.1.7",
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

# A second toolchain shares the pinned LLVM distribution but links Linux
# x86_64 targets against the checksum-pinned portable glibc sysroot.
llvm.toolchain(
    name = "llvm_toolchain_portable",
    cxx_standard = {"": "c++20"},
    llvm_version = "22.1.7",
)
llvm.toolchain_root(
    name = "llvm_toolchain_portable",
    label = "@llvm_toolchain_llvm//:BUILD",
)
llvm.sysroot(
    name = "llvm_toolchain_portable",
    label = "@linux_glibc_sysroot//:sysroot",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain_portable")

register_toolchains("@llvm_toolchain//:all")

# rules_cuda's redist integration downloads the compiler and static runtime
# closure from NVIDIA's checksum-pinned CUDA 13.0.2 manifest. The toolchain is
# independent of the host installation and produces one action per .cu file.
cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.redist_json(
    name = "rules_cuda_redist_json",
    version = "13.0.2",
)
cuda.toolkit(name = "cuda")
use_repo(
    cuda,
    "cuda",
    cuda_cublas = "cuda_cublas_v13.1.0.3",
)

register_toolchains("@cuda//toolchain:nvcc-local-toolchain")

# llama.cpp uses pinned CMake and Ninja. OpenSSL genuinely needs GNU Make, while
# M4 and pkg-config are only declared toolchain slots and must remain unused.
register_toolchains(
    "@rules_foreign_cc//toolchains:built_make_toolchain",
    "//tools:unused_m4_toolchain",
    "//tools:unused_pkgconfig_toolchain",
)

foreign_tools = use_extension("@rules_foreign_cc//foreign_cc:extensions.bzl", "tools")
foreign_tools.cmake(version = "3.31.8")
foreign_tools.ninja(version = "1.13.0")
use_repo(
    foreign_tools,
    "cmake_3.31.8_toolchains",
    "ninja_1.13.0_toolchains",
    "rules_foreign_cc_framework_toolchains",
)

register_toolchains(
    "@cmake_3.31.8_toolchains//:all",
    "@ninja_1.13.0_toolchains//:all",
    "@rules_foreign_cc_framework_toolchains//:all",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
cuda_sdk_repository = use_repo_rule("//tools:gpu_sdk_repositories.bzl", "cuda_sdk_repository")

cuda_sdk_repository(name = "cuda_sdk")

# Pinned GCC bundle used only for its libstdc++ headers and libraries. CUDA's
# x86 headers reject libc++, but NVCC still delegates every host compile to
# pinned Clang.
http_archive(
    name = "cuda_host_toolchain",
    build_file = "//third_party:cuda_host_toolchain.BUILD.bazel",
    patch_strip = 1,
    patches = ["//third_party:cuda_host_sysroot_package.patch"],
    sha256 = "d6eca7f1ea736ef6f868a027a9d0baa875f9513755026aed2badc04a2b9cd7bd",
    strip_prefix = "x86-64--glibc--stable-2023.08-1",
    urls = ["https://toolchains.bootlin.com/downloads/releases/toolchains/x86-64/tarballs/x86-64--glibc--stable-2023.08-1.tar.bz2"],
)

# Chromium's checksum-addressed Debian Stretch sysroot supplies glibc 2.24,
# keeping the release ABI below the documented glibc 2.28 ceiling.
http_archive(
    name = "linux_glibc_sysroot",
    build_file_content = """
package(default_visibility = ["//visibility:public"])
filegroup(name = "sysroot", srcs = glob(["**"]))
exports_files(["usr/include/stdlib.h"])
""",
    sha256 = "73d828bf653f8f8548be704ce1ded4d195bf2bf937fc5426dd5636a9940d1969",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/toolchain/3c248ba4290a5ad07085b7af07e6785bf1ae5b66/debian_stretch_amd64_sysroot.tar.xz"],
)

