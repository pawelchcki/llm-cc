 #include <condition_variable>
 #include <cstddef>
 #include <cstdint>
+#include <cstring>
 #include <cfloat>
 #include <initializer_list>
 #include <limits>
@@ -5580,4 +5581,48 @@ ggml_backend_t ggml_backend_cuda_init(int device) {
     return cuda_backend;
 }
-
+
+static int llm_cc_cuda_backend_score() {
+    int count = 0;
+    if (cudaGetDeviceCount(&count) != cudaSuccess) {
+        return 0;
+    }
+    for (int device = 0; device < count; ++device) {
+        cudaDeviceProp properties;
+        if (cudaGetDeviceProperties(&properties, device) != cudaSuccess) {
+            return 0;
+        }
+#if defined(GGML_USE_HIP)
+        const char * architecture = properties.gcnArchName;
+        bool is_supported = false;
+        for (const char * supported : {"gfx1100", "gfx1101", "gfx1102"}) {
+            const size_t length = std::strlen(supported);
+            if (std::strncmp(architecture, supported, length) == 0 &&
+                (architecture[length] == '\0' || architecture[length] == ':')) {
+                is_supported = true;
+                break;
+            }
+        }
+        if (!is_supported) {
+            return 0;
+        }
+#else
+        const int architecture = properties.major * 10 + properties.minor;
+        switch (architecture) {
+            case 75:
+            case 80:
+            case 86:
+            case 89:
+            case 90:
+            case 100:
+            case 120:
+                break;
+            default:
+                return 0;
+        }
+#endif
+    }
+    return count > 0 ? 1 : 0;
+}
+
+GGML_BACKEND_DL_SCORE_IMPL(llm_cc_cuda_backend_score)
 GGML_BACKEND_DL_IMPL(ggml_backend_cuda_reg)
