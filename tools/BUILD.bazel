load("@rules_foreign_cc//toolchains/native_tools:native_tools_toolchain.bzl", "native_tool_toolchain")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "cpp_sources",
    srcs = glob([
        "*.cc",
        "*.h",
    ]),
)

cc_binary(
    name = "embed_payloads",
    srcs = [
        "embed_payloads.cc",
        "sha256.h",
    ],
    deps = [
        "//:linux_compat",
        "//:payload_format",
    ],
)

cc_binary(
    name = "materialize_tree",
    srcs = ["materialize_tree.cc"],
    deps = ["//:linux_compat"],
)

sh_binary(
    name = "hermetic_clang_wrapper",
    srcs = ["hermetic_clang_wrapper.sh"],
)

exports_files([
    "bazel_status.sh",
    "cuda_glibc_compat.h",
    "cuda_archive.bzl",
    "cuda_host_compiler_wrapper.sh",
    "embed_payloads.cc",
    "format_test.sh",
    "hip_library.bzl",
    "hermetic_clang_wrapper.sh",
    "install.sh",
    "install_test.sh",
    "materialize_tree.cc",
    "model_smoke_test.sh",
    "package_payload.sh",
    "version.sh",
    "version_test.sh",
])

native_tool_toolchain(
    name = "unused_make",
    env = {"MAKE": "$(execpath :unused_foreign_tool.sh)"},
    path = "$(execpath :unused_foreign_tool.sh)",
    target = ":unused_foreign_tool.sh",
)

native_tool_toolchain(
    name = "unused_m4",
    env = {"M4": "$(execpath :unused_foreign_tool.sh)"},
    path = "$(execpath :unused_foreign_tool.sh)",
    target = ":unused_foreign_tool.sh",
)

native_tool_toolchain(
    name = "unused_pkgconfig",
    env = {"PKG_CONFIG": "$(execpath :unused_foreign_tool.sh)"},
    path = "$(execpath :unused_foreign_tool.sh)",
    target = ":unused_foreign_tool.sh",
)

toolchain(
    name = "unused_make_toolchain",
    toolchain = ":unused_make",
    toolchain_type = "@rules_foreign_cc//toolchains:make_toolchain",
)

toolchain(
    name = "unused_m4_toolchain",
    toolchain = ":unused_m4",
    toolchain_type = "@rules_foreign_cc//toolchains:m4_toolchain",
)

toolchain(
    name = "unused_pkgconfig_toolchain",
    toolchain = ":unused_pkgconfig",
    toolchain_type = "@rules_foreign_cc//toolchains:pkgconfig_toolchain",
)
